MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DB=inventory_db
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# O servidor se recusa a subir se a chave tiver menos de 32 caracteres.
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=2
# Teto da sessão: o token é renovado enquanto a pessoa usa o app, mas nunca passa disso desde o login.
JWT_SESSAO_MAX_HORAS=12
FRONTEND_URL=http://localhost:3000
FLASK_DEBUG=0
